NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://root:password@localhost:3306/thienTamWMS"

JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Tuỳ chọn (xem docs/05-ops/env-vars.md) ---
# LOG_LEVEL=debug                  # fatal|error|warn|info|debug|trace|silent
# CORS_ORIGINS=http://localhost:5173,https://wms.example.vn
# LOGIN_RATE_LIMIT=5              # số lần đăng nhập tối đa mỗi phút mỗi IP
# TRUST_PROXY=1                    # số tầng reverse proxy tin cậy
# SWAGGER_ENABLED=true             # mặc định: bật ở dev, tắt ở production
# SWAGGER_USER=
# SWAGGER_PASSWORD=                # bắt buộc nếu bật Swagger ở production
# SEED_ADMIN_PASSWORD=             # bắt buộc khi seed ở production


# Background jobs (expiry scan, stock reconcile)
JOBS_ENABLED=true

# Thư mục lưu tệp đính kèm trên đĩa (MySQL chỉ lưu đường dẫn tương đối)
# UPLOAD_DIR=./uploads
