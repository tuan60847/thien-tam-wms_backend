// ============================================================
// ThienTamWMS - Prisma Schema
// Hệ thống quản lý kho thuốc cho nhà phân phối
// Chuyển thể từ sơ đồ ERD ThienTamWMS
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // đổi thành "postgresql" nếu bạn dùng Postgres
}

// ------------------------------------------------------------
// ENUM TRẠNG THÁI
// ------------------------------------------------------------

enum TrangThaiPhieuNhap {
  cho_xac_nhan
  da_nhap_kho
  da_huy
}

enum TrangThaiPhieuXuat {
  cho_xu_ly
  da_xuat_kho
  da_giao
  da_huy
}

enum TrangThaiSoLo {
  con_han
  can_date
  het_han
}

enum TrangThaiKhachHang {
  hoat_dong
  ngung_hoat_dong
}

enum TrangThaiXacMinh {
  chua_xac_minh
  da_xac_minh
  tu_choi
}

enum LoaiKiemSoat {
  thuong
  ke_don
  kiem_soat_dac_biet
}

// Loại biến động của sổ cái tồn kho (BienDongTonKho)
enum LoaiBienDong {
  nhap_kho
  xuat_kho
  huy_nhap
  huy_xuat
  chuyen_di
  chuyen_den
  dieu_chinh
}

// ------------------------------------------------------------
// PHÂN QUYỀN NGƯỜI DÙNG
// ------------------------------------------------------------

model Role {
  id        String   @id @default(uuid())
  maRole    String   @unique @map("ma_role")
  tenRole   String   @map("ten_role")
  moTa      String?  @map("mo_ta")
  trangThai Boolean  @default(true) @map("trang_thai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("role")
}

model User {
  id        String   @id @default(uuid())
  maNV      String   @unique @map("ma_nv")
  username  String   @unique
  password  String
  hoTen     String   @map("ho_ten")
  email     String?  @unique
  trangThai Boolean  @default(true) @map("trang_thai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleId String? @map("role_id")
  role   Role?   @relation(fields: [roleId], references: [id])

  // Các phiếu do user này tạo — chỉ dùng để tính doanh số / thống kê,
  // không phải quan hệ nghiệp vụ bắt buộc.
  phieuXuatHangTao PhieuXuatHang[] @relation("PhieuXuatHangCreatedBy")
  phieuNhapHangTao PhieuNhapHang[] @relation("PhieuNhapHangCreatedBy")

  hangHoaTao        HangHoa[]        @relation("HangHoaCreatedBy")
  hangHoaSua        HangHoa[]        @relation("HangHoaUpdatedBy")
  khachHangTao      KhachHang[]      @relation("KhachHangCreatedBy")
  khachHangSua      KhachHang[]      @relation("KhachHangUpdatedBy")
  nhaCungCapTao     NhaCungCap[]     @relation("NhaCungCapCreatedBy")
  nhaCungCapSua     NhaCungCap[]     @relation("NhaCungCapUpdatedBy")
  nhaCungCapXacMinh NhaCungCap[]     @relation("NhaCungCapXacMinhBy")
  refreshTokens     RefreshToken[]
  nhatKy            NhatKyHeThong[]
  soLoTao           SoLo[]           @relation("SoLoCreatedBy")
  soLoSua           SoLo[]           @relation("SoLoUpdatedBy")
  bienDongTonKho    BienDongTonKho[]

  @@map("user")
}

// Refresh tokens are stored hashed (SHA-256) so logout and rotation work
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

// ------------------------------------------------------------
// DANH MỤC HÀNG HÓA
// ------------------------------------------------------------

model LoaiHang {
  id          String   @id @default(uuid())
  tenLoaiHang String   @unique @map("ten_loai_hang")
  ghiChu      String?  @map("ghi_chu") @db.VarChar(500)
  trangThai   Boolean  @default(true) @map("trang_thai")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  hangHoas HangHoa[]

  @@map("loai_hang")
}

model HangHoa {
  id           String        @id @default(uuid())
  maSP         String        @unique @map("ma_sp") @db.VarChar(20)
  tenSP        String        @map("ten_sp") @db.VarChar(200)
  quyCach      String?       @map("quy_cach") @db.VarChar(200)
  // Đơn vị mà giaNhap / giaHienThi / giaToiThieu tính theo (phải là một donViTinh của hàng)
  donViTinhGia String        @map("don_vi_tinh_gia") @db.VarChar(30)
  giaNhap      Decimal       @default(0) @map("gia_nhap") @db.Decimal(15, 2)
  giaHienThi   Decimal       @default(0) @map("gia_hien_thi") @db.Decimal(15, 2)
  giaToiThieu  Decimal       @default(0) @map("gia_toi_thieu") @db.Decimal(15, 2)
  isKeDon      Boolean       @default(false) @map("is_ke_don") // thuốc kê đơn
  isCanGiuLanh Boolean       @default(false) @map("is_can_giu_lanh") // cần bảo quản lạnh
  loaiKiemSoat LoaiKiemSoat? @map("loai_kiem_soat") // thường / kê đơn / kiểm soát đặc biệt
  soDangKy     String?       @map("so_dang_ky") // số đăng ký lưu hành thuốc
  ghiChu       String?       @map("ghi_chu") @db.VarChar(500)
  trangThai    Boolean       @default(true) @map("trang_thai")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  loaiHangId String   @map("loai_hang_id")
  loaiHang   LoaiHang @relation(fields: [loaiHangId], references: [id])

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("HangHoaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("HangHoaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  tyLeQuyDois TyLeQuyDoi[]
  soLos       SoLo[]

  @@map("hang_hoa")
}

model TyLeQuyDoi {
  id            String   @id @default(uuid())
  donViTinh     String   @map("don_vi_tinh") // hộp, vỉ, viên...
  soLuongQuyDoi Int      @map("so_luong_quy_doi") // quy đổi ra đơn vị nhỏ nhất
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  hangHoaId String  @map("hang_hoa_id")
  hangHoa   HangHoa @relation(fields: [hangHoaId], references: [id])

  @@unique([hangHoaId, donViTinh])
  @@map("ty_le_quy_doi")
}

// ------------------------------------------------------------
// LÔ HÀNG & TỒN KHO
// ------------------------------------------------------------

model SoLo {
  id        String        @id @default(uuid())
  tenLo     String        @map("ten_lo") @db.VarChar(50)
  ngaySX    DateTime?     @map("ngay_sx") @db.Date
  hanSuDung DateTime      @map("han_su_dung") @db.Date
  trangThai TrangThaiSoLo @default(con_han) @map("trang_thai") // con_han / can_date / het_han
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("SoLoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("SoLoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  hangHoaId String  @map("hang_hoa_id")
  hangHoa   HangHoa @relation(fields: [hangHoaId], references: [id])

  chiTietPhieuXuatHangs ChiTietPhieuXuatHang[]
  chiTietPhieuNhapHangs ChiTietPhieuNhapHang[]
  tonKhos               TonKho[]
  bienDongs             BienDongTonKho[]

  @@unique([hangHoaId, tenLo])
  @@index([hanSuDung])
  @@index([hangHoaId, hanSuDung])
  @@map("so_lo")
}

model Kho {
  id        String   @id @default(uuid())
  tenKho    String   @unique @map("ten_kho") @db.VarChar(100)
  diaChi    String?  @map("dia_chi") @db.VarChar(255)
  trangThai Boolean  @default(true) @map("trang_thai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  viTris ViTri[]

  @@map("kho")
}

model ViTri {
  id        String   @id @default(uuid())
  tenViTri  String   @map("ten_vi_tri") @db.VarChar(50)
  isCapDong Boolean  @default(false) @map("is_cap_dong") // vị trí bảo quản lạnh
  ghiChu    String?  @map("ghi_chu") @db.VarChar(255)
  trangThai Boolean  @default(true) @map("trang_thai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  khoId String @map("kho_id")
  kho   Kho    @relation(fields: [khoId], references: [id])

  tonKhos   TonKho[]
  bienDongs BienDongTonKho[]

  @@unique([khoId, tenViTri])
  @@map("vi_tri")
}

// Thực thể liên kết nhiều-nhiều giữa SoLo và ViTri
model TonKho {
  id        String   @id @default(uuid())
  soLuong   Int      @default(0) @map("so_luong")
  updatedAt DateTime @updatedAt @map("updated_at")

  soLoId String @map("so_lo_id")
  soLo   SoLo   @relation(fields: [soLoId], references: [id])

  viTriId String @map("vi_tri_id")
  viTri   ViTri  @relation(fields: [viTriId], references: [id])

  @@unique([soLoId, viTriId]) // mỗi lô ở mỗi vị trí chỉ có 1 dòng tồn
  @@map("ton_kho")
}

// ------------------------------------------------------------
// KHÁCH HÀNG (NHÀ THUỐC) & NHÀ CUNG CẤP
// ------------------------------------------------------------

model KhachHang {
  id           String             @id @default(uuid())
  maKH         String             @unique @map("ma_kh")
  tenKH        String             @map("ten_kh") @db.VarChar(200)
  diaChi       String?            @map("dia_chi") @db.VarChar(255)
  maSoThue     String?            @unique @map("ma_so_thue") @db.VarChar(14)
  email        String?            @db.VarChar(150)
  SDT          String?            @db.VarChar(15)
  nguoiDaiDien String?            @map("nguoi_dai_dien") @db.VarChar(100)
  SDTNDD       String?            @map("sdt_ndd") @db.VarChar(15) // SĐT người đại diện
  trangThai    TrangThaiKhachHang @default(hoat_dong) @map("trang_thai")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  // Đề xuất bổ sung để tuân thủ (chưa có trong bản vẽ gốc, nên thêm khi cần)
  soGiayPhepKinhDoanh String?   @map("so_giay_phep_kinh_doanh") @db.VarChar(50)
  ngayCapGPKD         DateTime? @map("ngay_cap_gpkd") @db.Date
  ngayHetHanGPKD      DateTime? @map("ngay_het_han_gpkd") @db.Date

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("KhachHangCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("KhachHangUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  phieuXuatHangs PhieuXuatHang[]

  @@map("khach_hang")
}

model NhaCungCap {
  id               String           @id @default(uuid())
  maNCC            String           @unique @map("ma_ncc") @db.VarChar(20)
  tenNCC           String           @map("ten_ncc") @db.VarChar(200)
  SDT              String?          @db.VarChar(15)
  diaChi           String?          @map("dia_chi") @db.VarChar(255)
  tenNguoiPhuTrach String?          @map("ten_nguoi_phu_trach") @db.VarChar(100)
  sdtNguoiPT       String?          @map("sdt_nguoi_pt") @db.VarChar(15)
  trangThaiXacMinh TrangThaiXacMinh @default(chua_xac_minh) @map("trang_thai_xac_minh")
  ghiChu           String?          @map("ghi_chu") @db.VarChar(500)
  trangThai        Boolean          @default(true) @map("trang_thai")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  soGiayPhepKinhDoanh String?   @map("so_giay_phep_kinh_doanh") @db.VarChar(50)
  ngayCapGPKD         DateTime? @map("ngay_cap_gpkd") @db.Date
  noiCapGPKD          String?   @map("noi_cap_gpkd") @db.VarChar(255)
  ngayHetHanGPKD      DateTime? @map("ngay_het_han_gpkd") @db.Date

  soGCNDuDieuKienKinhDoanhDuoc String?   @map("so_gcn_du_dieu_kien_kinh_doanh_duoc") @db.VarChar(50)
  ngayCapGCNDuoc               DateTime? @map("ngay_cap_gcn_duoc") @db.Date
  noiCapGCNDuoc                String?   @map("noi_cap_gcn_duoc") @db.VarChar(255)
  ngayHetHanGCNDuoc            DateTime? @map("ngay_het_han_gcn_duoc") @db.Date

  // Người và thời điểm xác minh / từ chối gần nhất
  xacMinhAt   DateTime? @map("xac_minh_at")
  xacMinhById String?   @map("xac_minh_by_id")
  xacMinhBoi  User?     @relation("NhaCungCapXacMinhBy", fields: [xacMinhById], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("NhaCungCapCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("NhaCungCapUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  phieuNhapHangs PhieuNhapHang[]

  @@map("nha_cung_cap")
}

// ------------------------------------------------------------
// PHƯƠNG TIỆN VẬN CHUYỂN
// ------------------------------------------------------------

model PhuongTienVanChuyen {
  id             String   @id @default(uuid())
  bienSo         String   @unique @map("bien_so") @db.VarChar(15)
  loaiPhuongTien String?  @map("loai_phuong_tien") @db.VarChar(50)
  isXeLanh       Boolean  @default(false) @map("is_xe_lanh") // xe có thể chở hàng cần bảo quản lạnh
  trangThai      Boolean  @default(true) @map("trang_thai")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  phieuNhapHangs PhieuNhapHang[]

  @@map("phuong_tien_van_chuyen")
}

// ------------------------------------------------------------
// PHIẾU NHẬP HÀNG
// ------------------------------------------------------------

model PhieuNhapHang {
  id              String             @id @default(uuid())
  maPhieuNhapHang String             @unique @map("ma_phieu_nhap_hang")
  ngayNhanHang    DateTime?          @map("ngay_nhan_hang")
  trangThai       TrangThaiPhieuNhap @default(cho_xac_nhan) @map("trang_thai")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  nhaCungCapId String     @map("nha_cung_cap_id")
  nhaCungCap   NhaCungCap @relation(fields: [nhaCungCapId], references: [id])

  phuongTienVanChuyenId String?              @map("phuong_tien_van_chuyen_id")
  phuongTienVanChuyen   PhuongTienVanChuyen? @relation(fields: [phuongTienVanChuyenId], references: [id])

  // Dùng để tính doanh số / thống kê theo người tạo, không phải khóa nghiệp vụ bắt buộc
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("PhieuNhapHangCreatedBy", fields: [createdById], references: [id])

  chiTietPhieuNhapHangs ChiTietPhieuNhapHang[]
  phieuThanhToans       PhieuThanhToan[]

  @@index([trangThai, createdAt])
  @@map("phieu_nhap_hang")
}

model ChiTietPhieuNhapHang {
  id                     String   @id @default(uuid())
  maChiTietPhieuNhapHang String   @unique @map("ma_chi_tiet_phieu_nhap_hang")
  soLuong                Int      @map("so_luong")
  donGia                 Decimal  @map("don_gia") @db.Decimal(15, 2)
  createdAt              DateTime @default(now()) @map("created_at")

  phieuNhapHangId String        @map("phieu_nhap_hang_id")
  phieuNhapHang   PhieuNhapHang @relation(fields: [phieuNhapHangId], references: [id])

  // 1 lô có thể có nhiều dòng chi tiết nhập hàng (nhập nhiều lần),
  // nhưng 1 dòng chi tiết nhập hàng chỉ ứng với đúng 1 lô
  soLoId String @map("so_lo_id")
  soLo   SoLo   @relation(fields: [soLoId], references: [id])

  @@map("chi_tiet_phieu_nhap_hang")
}

// ------------------------------------------------------------
// PHIẾU XUẤT HÀNG
// ------------------------------------------------------------

model PhieuXuatHang {
  id              String             @id @default(uuid())
  maPhieuXuatHang String             @unique @map("ma_phieu_xuat_hang")
  ngayGiaoHang    DateTime?          @map("ngay_giao_hang")
  diaChiGiaoHang  String?            @map("dia_chi_giao_hang")
  trangThai       TrangThaiPhieuXuat @default(cho_xu_ly) @map("trang_thai")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  khachHangId String    @map("khach_hang_id")
  khachHang   KhachHang @relation(fields: [khachHangId], references: [id])

  // Dùng để tính doanh số / thống kê theo người tạo, không phải khóa nghiệp vụ bắt buộc
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("PhieuXuatHangCreatedBy", fields: [createdById], references: [id])

  chiTietPhieuXuatHangs ChiTietPhieuXuatHang[]
  phieuThuCongNos       PhieuThuCongNo[]

  @@index([trangThai, createdAt])
  @@map("phieu_xuat_hang")
}

model ChiTietPhieuXuatHang {
  id                     String   @id @default(uuid())
  maChiTietPhieuXuatHang String   @unique @map("ma_chi_tiet_phieu_xuat_hang")
  soLuong                Int      @map("so_luong")
  donGia                 Decimal  @map("don_gia") @db.Decimal(15, 2)
  createdAt              DateTime @default(now()) @map("created_at")

  phieuXuatHangId String        @map("phieu_xuat_hang_id")
  phieuXuatHang   PhieuXuatHang @relation(fields: [phieuXuatHangId], references: [id])

  // Truy vết lô: 1 dòng xuất lấy hàng từ 1 lô cụ thể
  soLoId String @map("so_lo_id")
  soLo   SoLo   @relation(fields: [soLoId], references: [id])

  @@map("chi_tiet_phieu_xuat_hang")
}

// ------------------------------------------------------------
// CÔNG NỢ: THU TỪ KHÁCH HÀNG / THANH TOÁN CHO NHÀ CUNG CẤP
// ------------------------------------------------------------

model PhieuThuCongNo {
  id               String   @id @default(uuid())
  maPhieuThuCongNo String   @unique @map("ma_phieu_thu_cong_no")
  soTien           Decimal  @map("so_tien") @db.Decimal(15, 2)
  ngayThanhToan    DateTime @map("ngay_thanh_toan") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  phieuXuatHangId String        @map("phieu_xuat_hang_id")
  phieuXuatHang   PhieuXuatHang @relation(fields: [phieuXuatHangId], references: [id])

  @@index([ngayThanhToan])
  @@map("phieu_thu_cong_no")
}

model PhieuThanhToan {
  id               String   @id @default(uuid())
  maPhieuThanhToan String   @unique @map("ma_phieu_thanh_toan")
  soTien           Decimal  @map("so_tien") @db.Decimal(15, 2)
  ngayThanhToan    DateTime @map("ngay_thanh_toan") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  phieuNhapHangId String        @map("phieu_nhap_hang_id")
  phieuNhapHang   PhieuNhapHang @relation(fields: [phieuNhapHangId], references: [id])

  @@index([ngayThanhToan])
  @@map("phieu_thanh_toan")
}

// ------------------------------------------------------------
// HẠ TẦNG DÙNG CHUNG
// ------------------------------------------------------------

// Nhật ký thao tác nhạy cảm (append-only). Xem docs/03-cross-cutting/audit-trail.md
model NhatKyHeThong {
  id         String   @id @default(uuid())
  hanhDong   String   @map("hanh_dong") @db.VarChar(100)
  doiTuong   String   @map("doi_tuong") @db.VarChar(50)
  doiTuongId String?  @map("doi_tuong_id") @db.VarChar(36)
  truoc      Json?
  sau        Json?
  lyDo       String?  @map("ly_do") @db.VarChar(255)
  ip         String?  @db.VarChar(45)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([doiTuong, doiTuongId])
  @@index([hanhDong, createdAt])
  @@index([userId, createdAt])
  @@map("nhat_ky_he_thong")
}

// Bộ đếm sinh mã chứng từ. ngay = 'yyMMdd' với mã theo ngày, '' với mã liên tục.
model BoDemMa {
  tienTo String @map("tien_to") @db.VarChar(10)
  ngay   String @default("") @db.VarChar(6)
  giaTri Int    @default(0) @map("gia_tri")

  @@id([tienTo, ngay])
  @@map("bo_dem_ma")
}

// Sổ cái biến động tồn kho (append-only). Với mỗi (soLoId, viTriId):
// TonKho.soLuong = tổng soLuongThayDoi. Xem docs/03-cross-cutting/audit-trail.md
model BienDongTonKho {
  id             String       @id @default(uuid())
  loai           LoaiBienDong
  soLuongThayDoi Int          @map("so_luong_thay_doi") // có dấu, đơn vị cơ bản
  soLuongSau     Int          @map("so_luong_sau")
  loaiThamChieu  String?      @map("loai_tham_chieu") @db.VarChar(50)
  thamChieuId    String?      @map("tham_chieu_id") @db.VarChar(36)
  lyDo           String?      @map("ly_do") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at")

  soLoId String @map("so_lo_id")
  soLo   SoLo   @relation(fields: [soLoId], references: [id])

  viTriId String @map("vi_tri_id")
  viTri   ViTri  @relation(fields: [viTriId], references: [id])

  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([soLoId, createdAt])
  @@index([viTriId, createdAt])
  @@index([loaiThamChieu, thamChieuId])
  @@map("bien_dong_ton_kho")
}
