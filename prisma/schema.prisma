// ============================================================
// ThienTamWMS - Prisma Schema
// Hệ thống quản lý kho thuốc cho nhà phân phối
// Chuyển thể từ sơ đồ ERD ThienTamWMS
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // đổi thành "postgresql" nếu bạn dùng Postgres
}

// ------------------------------------------------------------
// ENUM TRẠNG THÁI
// ------------------------------------------------------------

enum TrangThaiPhieuNhap {
  cho_xac_nhan
  da_nhap_kho
  da_huy
}

enum TrangThaiPhieuXuat {
  cho_xu_ly
  da_xuat_kho
  da_giao
  da_huy
}

enum TrangThaiSoLo {
  con_han
  can_date
  het_han
}

enum TrangThaiKhachHang {
  hoat_dong
  ngung_hoat_dong
}

enum TrangThaiXacMinh {
  chua_xac_minh
  da_xac_minh
  tu_choi
}

enum LoaiKiemSoat {
  thuong
  ke_don
  kiem_soat_dac_biet
}

// Phương thức thanh toán cho nhà cung cấp
// Đối tượng có thể đính kèm tệp (TepDinhKem.loaiDoiTuong)
enum LoaiDoiTuongTep {
  khach_hang
  nha_cung_cap
  hang_hoa
  phieu_nhap_hang
  so_lo
}

// Tổ chức hay cá nhân (form khách hàng / nhà cung cấp)
enum LoaiChuThe {
  to_chuc
  ca_nhan
}

// Thanh toán khi lập chứng từ bán hàng: ghi nợ hay thu tiền ngay
enum HinhThucThanhToan {
  chua_thu_tien
  thu_tien_ngay
}

// Tình trạng nợ của một phiếu xuất (phân tích công nợ)
enum TinhTrangNo {
  no_binh_thuong
  no_kho_doi
  no_khong_the_doi
}

enum PhuongThucThanhToan {
  tien_mat
  chuyen_khoan
}

// Loại biến động của sổ cái tồn kho (BienDongTonKho)
enum LoaiBienDong {
  nhap_kho
  xuat_kho
  huy_nhap
  huy_xuat
  chuyen_di
  chuyen_den
  dieu_chinh
  tra_hang // khách trả lại hàng bán, nhập lại kho
}

// ------------------------------------------------------------
// PHÂN QUYỀN NGƯỜI DÙNG
// ------------------------------------------------------------

model Role {
  id        String   @id @default(uuid())
  maRole    String   @unique @map("ma_role")
  tenRole   String   @map("ten_role")
  moTa      String?  @map("mo_ta")
  trangThai Boolean  @default(true) @map("trang_thai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("role")
}

model User {
  id        String   @id @default(uuid())
  maNV      String   @unique @map("ma_nv")
  username  String   @unique
  password  String
  hoTen     String   @map("ho_ten")
  email     String?  @unique
  trangThai Boolean  @default(true) @map("trang_thai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleId String? @map("role_id")
  role   Role?   @relation(fields: [roleId], references: [id])

  // Các phiếu do user này tạo — chỉ dùng để tính doanh số / thống kê,
  // không phải quan hệ nghiệp vụ bắt buộc.
  phieuXuatHangTao  PhieuXuatHang[]    @relation("PhieuXuatHangCreatedBy")
  phieuXuatHangSua  PhieuXuatHang[]    @relation("PhieuXuatHangUpdatedBy")
  phieuXuatKho      PhieuXuatHang[]    @relation("PhieuXuatHangIssuedBy")
  phieuXuatHuy      PhieuXuatHang[]    @relation("PhieuXuatHangCancelledBy")
  phieuThuTao       PhieuThuCongNo[]   @relation("PhieuThuCongNoCreatedBy")
  phieuThuHuy       PhieuThuCongNo[]   @relation("PhieuThuCongNoVoidedBy")
  tepDinhKems       TepDinhKem[]
  nhanVienKinhDoanh NhanVienKinhDoanh?
  baoGiaTao         BaoGia[]           @relation("BaoGiaCreatedBy")
  traLaiTao         TraLaiHangBan[]    @relation("TraLaiHangBanCreatedBy")
  doiTruTao         DoiTruChungTu[]    @relation("DoiTruChungTuCreatedBy")
  phieuNhapHangTao  PhieuNhapHang[]    @relation("PhieuNhapHangCreatedBy")
  phieuNhapHangSua  PhieuNhapHang[]    @relation("PhieuNhapHangUpdatedBy")
  phieuNhapXacNhan  PhieuNhapHang[]    @relation("PhieuNhapHangConfirmedBy")
  phieuNhapHuy      PhieuNhapHang[]    @relation("PhieuNhapHangCancelledBy")
  phieuThanhToanTao PhieuThanhToan[]   @relation("PhieuThanhToanCreatedBy")
  phieuThanhToanHuy PhieuThanhToan[]   @relation("PhieuThanhToanVoidedBy")

  hangHoaTao        HangHoa[]        @relation("HangHoaCreatedBy")
  hangHoaSua        HangHoa[]        @relation("HangHoaUpdatedBy")
  khachHangTao      KhachHang[]      @relation("KhachHangCreatedBy")
  khachHangSua      KhachHang[]      @relation("KhachHangUpdatedBy")
  nhaCungCapTao     NhaCungCap[]     @relation("NhaCungCapCreatedBy")
  nhaCungCapSua     NhaCungCap[]     @relation("NhaCungCapUpdatedBy")
  nhaCungCapXacMinh NhaCungCap[]     @relation("NhaCungCapXacMinhBy")
  refreshTokens     RefreshToken[]
  nhatKy            NhatKyHeThong[]
  soLoTao           SoLo[]           @relation("SoLoCreatedBy")
  soLoSua           SoLo[]           @relation("SoLoUpdatedBy")
  bienDongTonKho    BienDongTonKho[]

  @@map("user")
}

// Refresh tokens are stored hashed (SHA-256) so logout and rotation work
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

// ------------------------------------------------------------
// DANH MỤC HÀNG HÓA
// ------------------------------------------------------------

model LoaiHang {
  id          String   @id @default(uuid())
  tenLoaiHang String   @unique @map("ten_loai_hang")
  ghiChu      String?  @map("ghi_chu") @db.VarChar(500)
  trangThai   Boolean  @default(true) @map("trang_thai")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  hangHoas HangHoa[]

  @@map("loai_hang")
}

model HangHoa {
  id           String        @id @default(uuid())
  maSP         String        @unique @map("ma_sp") @db.VarChar(20)
  tenSP        String        @map("ten_sp") @db.VarChar(200)
  quyCach      String?       @map("quy_cach") @db.VarChar(200)
  // Đơn vị mà giaNhap / giaHienThi / giaToiThieu tính theo (phải là một donViTinh của hàng)
  donViTinhGia String        @map("don_vi_tinh_gia") @db.VarChar(30)
  giaNhap      Decimal       @default(0) @map("gia_nhap") @db.Decimal(15, 2)
  giaHienThi   Decimal       @default(0) @map("gia_hien_thi") @db.Decimal(15, 2)
  giaToiThieu  Decimal       @default(0) @map("gia_toi_thieu") @db.Decimal(15, 2)
  isKeDon      Boolean       @default(false) @map("is_ke_don") // thuốc kê đơn
  isCanGiuLanh Boolean       @default(false) @map("is_can_giu_lanh") // cần bảo quản lạnh
  loaiKiemSoat LoaiKiemSoat? @map("loai_kiem_soat") // thường / kê đơn / kiểm soát đặc biệt
  soDangKy     String?       @map("so_dang_ky") // số đăng ký lưu hành thuốc
  ghiChu       String?       @map("ghi_chu") @db.VarChar(500)
  trangThai    Boolean       @default(true) @map("trang_thai")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  loaiHangId String   @map("loai_hang_id")
  loaiHang   LoaiHang @relation(fields: [loaiHangId], references: [id])

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("HangHoaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("HangHoaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  tyLeQuyDois TyLeQuyDoi[]
  soLos       SoLo[]

  // Bổ sung theo màn hình MISA
  maQuyCach    String? @map("ma_quy_cach") @db.VarChar(50)
  thueSuatGtgt Decimal @default(0) @map("thue_suat_gtgt") @db.Decimal(5, 2)

  chiTietBaoGias ChiTietBaoGia[]

  @@map("hang_hoa")
}

model TyLeQuyDoi {
  id            String   @id @default(uuid())
  donViTinh     String   @map("don_vi_tinh") // hộp, vỉ, viên...
  soLuongQuyDoi Int      @map("so_luong_quy_doi") // quy đổi ra đơn vị nhỏ nhất
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  hangHoaId String  @map("hang_hoa_id")
  hangHoa   HangHoa @relation(fields: [hangHoaId], references: [id])

  @@unique([hangHoaId, donViTinh])
  @@map("ty_le_quy_doi")
}

// ------------------------------------------------------------
// LÔ HÀNG & TỒN KHO
// ------------------------------------------------------------

model SoLo {
  id        String        @id @default(uuid())
  tenLo     String        @map("ten_lo") @db.VarChar(50)
  ngaySX    DateTime?     @map("ngay_sx") @db.Date
  hanSuDung DateTime      @map("han_su_dung") @db.Date
  trangThai TrangThaiSoLo @default(con_han) @map("trang_thai") // con_han / can_date / het_han
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("SoLoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("SoLoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  hangHoaId String  @map("hang_hoa_id")
  hangHoa   HangHoa @relation(fields: [hangHoaId], references: [id])

  chiTietPhieuXuatHangs ChiTietPhieuXuatHang[]
  chiTietPhieuNhapHangs ChiTietPhieuNhapHang[]
  tonKhos               TonKho[]
  bienDongs             BienDongTonKho[]

  chiTietTraLais ChiTietTraLai[]

  @@unique([hangHoaId, tenLo])
  @@index([hanSuDung])
  @@index([hangHoaId, hanSuDung])
  @@map("so_lo")
}

model Kho {
  id        String   @id @default(uuid())
  tenKho    String   @unique @map("ten_kho") @db.VarChar(100)
  diaChi    String?  @map("dia_chi") @db.VarChar(255)
  trangThai Boolean  @default(true) @map("trang_thai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  viTris ViTri[]

  @@map("kho")
}

model ViTri {
  id        String   @id @default(uuid())
  tenViTri  String   @map("ten_vi_tri") @db.VarChar(50)
  isCapDong Boolean  @default(false) @map("is_cap_dong") // vị trí bảo quản lạnh
  ghiChu    String?  @map("ghi_chu") @db.VarChar(255)
  trangThai Boolean  @default(true) @map("trang_thai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  khoId String @map("kho_id")
  kho   Kho    @relation(fields: [khoId], references: [id])

  tonKhos               TonKho[]
  bienDongs             BienDongTonKho[]
  chiTietPhieuNhapHangs ChiTietPhieuNhapHang[]
  chiTietPhieuXuatHangs ChiTietPhieuXuatHang[]

  chiTietTraLais ChiTietTraLai[]

  @@unique([khoId, tenViTri])
  @@map("vi_tri")
}

// Thực thể liên kết nhiều-nhiều giữa SoLo và ViTri
model TonKho {
  id        String   @id @default(uuid())
  soLuong   Int      @default(0) @map("so_luong")
  updatedAt DateTime @updatedAt @map("updated_at")

  soLoId String @map("so_lo_id")
  soLo   SoLo   @relation(fields: [soLoId], references: [id])

  viTriId String @map("vi_tri_id")
  viTri   ViTri  @relation(fields: [viTriId], references: [id])

  @@unique([soLoId, viTriId]) // mỗi lô ở mỗi vị trí chỉ có 1 dòng tồn
  @@map("ton_kho")
}

// ------------------------------------------------------------
// KHÁCH HÀNG (NHÀ THUỐC) & NHÀ CUNG CẤP
// ------------------------------------------------------------

model KhachHang {
  id           String             @id @default(uuid())
  maKH         String             @unique @map("ma_kh")
  tenKH        String             @map("ten_kh") @db.VarChar(200)
  diaChi       String?            @map("dia_chi") @db.VarChar(255)
  maSoThue     String?            @unique @map("ma_so_thue") @db.VarChar(14)
  email        String?            @db.VarChar(150)
  SDT          String?            @db.VarChar(15)
  nguoiDaiDien String?            @map("nguoi_dai_dien") @db.VarChar(100)
  SDTNDD       String?            @map("sdt_ndd") @db.VarChar(15) // SĐT người đại diện
  trangThai    TrangThaiKhachHang @default(hoat_dong) @map("trang_thai")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  // Đề xuất bổ sung để tuân thủ (chưa có trong bản vẽ gốc, nên thêm khi cần)
  soGiayPhepKinhDoanh String?   @map("so_giay_phep_kinh_doanh") @db.VarChar(50)
  ngayCapGPKD         DateTime? @map("ngay_cap_gpkd") @db.Date
  ngayHetHanGPKD      DateTime? @map("ngay_het_han_gpkd") @db.Date

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("KhachHangCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("KhachHangUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  phieuXuatHangs PhieuXuatHang[]

  // ---- Bổ sung theo màn hình MISA: hạn nợ, phân loại, liên hệ, địa lý ----
  loaiChuThe LoaiChuThe @default(to_chuc) @map("loai_chu_the")
  xungHo     String?    @map("xung_ho") @db.VarChar(20)
  dienGiai   String?    @map("dien_giai") @db.VarChar(500)
  soCCCD     String?    @map("so_cccd") @db.VarChar(20)
  soHoChieu  String?    @map("so_ho_chieu") @db.VarChar(30)
  ngayCap    DateTime?  @map("ngay_cap") @db.Date
  noiCap     String?    @map("noi_cap") @db.VarChar(255)
  dtCoDinh   String?    @map("dt_co_dinh") @db.VarChar(20)
  fax        String?    @db.VarChar(20)
  website    String?    @db.VarChar(200)

  // Điều khoản nợ (câu mở #44): 0 = không giới hạn / chưa đặt
  soNgayDuocNo Int?    @map("so_ngay_duoc_no")
  soNoToiDa    Decimal @default(0) @map("so_no_toi_da") @db.Decimal(15, 2)

  quocGia   String  @default("Việt Nam") @map("quoc_gia") @db.VarChar(100)
  tinhTp    String? @map("tinh_tp") @db.VarChar(100)
  quanHuyen String? @map("quan_huyen") @db.VarChar(100)
  xaPhuong  String? @map("xa_phuong") @db.VarChar(100)

  // Người liên hệ và người nhận hóa đơn (tab "Khác")
  lienHeHoTen         String? @map("lien_he_ho_ten") @db.VarChar(200)
  lienHeChucDanh      String? @map("lien_he_chuc_danh") @db.VarChar(100)
  lienHeDienThoai     String? @map("lien_he_dien_thoai") @db.VarChar(20)
  lienHeEmail         String? @map("lien_he_email") @db.VarChar(150)
  lienHeDiaChi        String? @map("lien_he_dia_chi") @db.VarChar(500)
  daiDienTheoPhapLuat String? @map("dai_dien_theo_phap_luat") @db.VarChar(200)
  hoaDonTenNguoiNhan  String? @map("hoa_don_ten_nguoi_nhan") @db.VarChar(200)
  hoaDonDienThoai     String? @map("hoa_don_dien_thoai") @db.VarChar(20)
  hoaDonDiaChi        String? @map("hoa_don_dia_chi") @db.VarChar(500)
  hoaDonEmail         String? @map("hoa_don_email") @db.VarChar(150)

  nhomDoiTacId String?     @map("nhom_doi_tac_id")
  nhomDoiTac   NhomDoiTac? @relation("KhachHangNhom", fields: [nhomDoiTacId], references: [id], onDelete: SetNull)

  dieuKhoanThanhToanId String?             @map("dieu_khoan_thanh_toan_id")
  dieuKhoanThanhToan   DieuKhoanThanhToan? @relation("KhachHangDieuKhoan", fields: [dieuKhoanThanhToanId], references: [id], onDelete: SetNull)

  nhanVienBanHangId String?            @map("nhan_vien_ban_hang_id")
  nhanVienBanHang   NhanVienKinhDoanh? @relation("KhachHangNhanVien", fields: [nhanVienBanHangId], references: [id], onDelete: SetNull)

  taiKhoanNganHangs TaiKhoanNganHang[] @relation("KhachHangNganHang")
  diaDiemGiaoHangs  DiaDiemGiaoHang[]
  baoGias           BaoGia[]
  traLaiHangBans    TraLaiHangBan[]

  @@map("khach_hang")
}

model NhaCungCap {
  id               String           @id @default(uuid())
  maNCC            String           @unique @map("ma_ncc") @db.VarChar(20)
  tenNCC           String           @map("ten_ncc") @db.VarChar(200)
  SDT              String?          @db.VarChar(15)
  diaChi           String?          @map("dia_chi") @db.VarChar(255)
  tenNguoiPhuTrach String?          @map("ten_nguoi_phu_trach") @db.VarChar(100)
  sdtNguoiPT       String?          @map("sdt_nguoi_pt") @db.VarChar(15)
  trangThaiXacMinh TrangThaiXacMinh @default(chua_xac_minh) @map("trang_thai_xac_minh")
  ghiChu           String?          @map("ghi_chu") @db.VarChar(500)
  trangThai        Boolean          @default(true) @map("trang_thai")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  soGiayPhepKinhDoanh String?   @map("so_giay_phep_kinh_doanh") @db.VarChar(50)
  ngayCapGPKD         DateTime? @map("ngay_cap_gpkd") @db.Date
  noiCapGPKD          String?   @map("noi_cap_gpkd") @db.VarChar(255)
  ngayHetHanGPKD      DateTime? @map("ngay_het_han_gpkd") @db.Date

  soGCNDuDieuKienKinhDoanhDuoc String?   @map("so_gcn_du_dieu_kien_kinh_doanh_duoc") @db.VarChar(50)
  ngayCapGCNDuoc               DateTime? @map("ngay_cap_gcn_duoc") @db.Date
  noiCapGCNDuoc                String?   @map("noi_cap_gcn_duoc") @db.VarChar(255)
  ngayHetHanGCNDuoc            DateTime? @map("ngay_het_han_gcn_duoc") @db.Date

  // Người và thời điểm xác minh / từ chối gần nhất
  xacMinhAt   DateTime? @map("xac_minh_at")
  xacMinhById String?   @map("xac_minh_by_id")
  xacMinhBoi  User?     @relation("NhaCungCapXacMinhBy", fields: [xacMinhById], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("NhaCungCapCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("NhaCungCapUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  phieuNhapHangs PhieuNhapHang[]

  // ---- Bổ sung theo màn hình MISA ----
  loaiChuThe   LoaiChuThe @default(to_chuc) @map("loai_chu_the")
  maSoThue     String?    @map("ma_so_thue") @db.VarChar(20)
  soCCCD       String?    @map("so_cccd") @db.VarChar(20)
  email        String?    @db.VarChar(150)
  dtCoDinh     String?    @map("dt_co_dinh") @db.VarChar(20)
  fax          String?    @db.VarChar(20)
  website      String?    @db.VarChar(200)
  soNgayDuocNo Int?       @map("so_ngay_duoc_no")
  soNoToiDa    Decimal    @default(0) @map("so_no_toi_da") @db.Decimal(15, 2)
  quocGia      String     @default("Việt Nam") @map("quoc_gia") @db.VarChar(100)
  tinhTp       String?    @map("tinh_tp") @db.VarChar(100)
  quanHuyen    String?    @map("quan_huyen") @db.VarChar(100)
  xaPhuong     String?    @map("xa_phuong") @db.VarChar(100)

  nhomDoiTacId String?     @map("nhom_doi_tac_id")
  nhomDoiTac   NhomDoiTac? @relation("NhaCungCapNhom", fields: [nhomDoiTacId], references: [id], onDelete: SetNull)

  dieuKhoanThanhToanId String?             @map("dieu_khoan_thanh_toan_id")
  dieuKhoanThanhToan   DieuKhoanThanhToan? @relation("NhaCungCapDieuKhoan", fields: [dieuKhoanThanhToanId], references: [id], onDelete: SetNull)

  nhanVienMuaHangId String?            @map("nhan_vien_mua_hang_id")
  nhanVienMuaHang   NhanVienKinhDoanh? @relation("NhaCungCapNhanVien", fields: [nhanVienMuaHangId], references: [id], onDelete: SetNull)

  taiKhoanNganHangs TaiKhoanNganHang[] @relation("NhaCungCapNganHang")

  @@map("nha_cung_cap")
}

// ------------------------------------------------------------
// PHƯƠNG TIỆN VẬN CHUYỂN
// ------------------------------------------------------------

model PhuongTienVanChuyen {
  id             String   @id @default(uuid())
  bienSo         String   @unique @map("bien_so") @db.VarChar(15)
  loaiPhuongTien String?  @map("loai_phuong_tien") @db.VarChar(50)
  isXeLanh       Boolean  @default(false) @map("is_xe_lanh") // xe có thể chở hàng cần bảo quản lạnh
  trangThai      Boolean  @default(true) @map("trang_thai")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  phieuNhapHangs PhieuNhapHang[]
  phieuXuatHangs PhieuXuatHang[]

  @@map("phuong_tien_van_chuyen")
}

// ------------------------------------------------------------
// PHIẾU NHẬP HÀNG
// ------------------------------------------------------------

model PhieuNhapHang {
  id              String             @id @default(uuid())
  maPhieuNhapHang String             @unique @map("ma_phieu_nhap_hang")
  ngayNhanHang    DateTime?          @map("ngay_nhan_hang") @db.Date
  ghiChu          String?            @map("ghi_chu") @db.VarChar(500)
  xacNhanAt       DateTime?          @map("xac_nhan_at")
  huyAt           DateTime?          @map("huy_at")
  lyDoHuy         String?            @map("ly_do_huy") @db.VarChar(255)
  trangThai       TrangThaiPhieuNhap @default(cho_xac_nhan) @map("trang_thai")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  nhaCungCapId String     @map("nha_cung_cap_id")
  nhaCungCap   NhaCungCap @relation(fields: [nhaCungCapId], references: [id])

  phuongTienVanChuyenId String?              @map("phuong_tien_van_chuyen_id")
  phuongTienVanChuyen   PhuongTienVanChuyen? @relation(fields: [phuongTienVanChuyenId], references: [id])

  // Dùng để tính doanh số / thống kê theo người tạo, không phải khóa nghiệp vụ bắt buộc
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("PhieuNhapHangCreatedBy", fields: [createdById], references: [id])

  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("PhieuNhapHangUpdatedBy", fields: [updatedById], references: [id])

  xacNhanById String? @map("xac_nhan_by_id")
  xacNhanBoi  User?   @relation("PhieuNhapHangConfirmedBy", fields: [xacNhanById], references: [id])

  huyById String? @map("huy_by_id")
  huyBoi  User?   @relation("PhieuNhapHangCancelledBy", fields: [huyById], references: [id])

  chiTietPhieuNhapHangs ChiTietPhieuNhapHang[]
  phieuThanhToans       PhieuThanhToan[]

  @@index([trangThai, createdAt])
  @@map("phieu_nhap_hang")
}

model ChiTietPhieuNhapHang {
  id                     String   @id @default(uuid())
  maChiTietPhieuNhapHang String   @unique @map("ma_chi_tiet_phieu_nhap_hang")
  soLuong                Int      @map("so_luong") // theo donViTinh của dòng
  donViTinh              String   @map("don_vi_tinh") @db.VarChar(30)
  heSoQuyDoi             Int      @map("he_so_quy_doi") // snapshot lúc lập phiếu
  soLuongCoBan           Int      @map("so_luong_co_ban") // = soLuong × heSoQuyDoi
  donGia                 Decimal  @map("don_gia") @db.Decimal(15, 2) // theo donViTinh của dòng
  createdAt              DateTime @default(now()) @map("created_at")

  phieuNhapHangId String        @map("phieu_nhap_hang_id")
  phieuNhapHang   PhieuNhapHang @relation(fields: [phieuNhapHangId], references: [id])

  // 1 lô có thể có nhiều dòng chi tiết nhập hàng (nhập nhiều lần),
  // nhưng 1 dòng chi tiết nhập hàng chỉ ứng với đúng 1 lô
  soLoId String @map("so_lo_id")
  soLo   SoLo   @relation(fields: [soLoId], references: [id])

  viTriId String @map("vi_tri_id")
  viTri   ViTri  @relation(fields: [viTriId], references: [id])

  @@unique([phieuNhapHangId, soLoId, viTriId])
  @@map("chi_tiet_phieu_nhap_hang")
}

// ------------------------------------------------------------
// PHIẾU XUẤT HÀNG
// ------------------------------------------------------------

model PhieuXuatHang {
  id              String             @id @default(uuid())
  maPhieuXuatHang String             @unique @map("ma_phieu_xuat_hang")
  ngayGiaoHang    DateTime?          @map("ngay_giao_hang") @db.Date // dự kiến
  ngayGiaoThucTe  DateTime?          @map("ngay_giao_thuc_te") @db.Date
  ngayXuatKho     DateTime?          @map("ngay_xuat_kho") @db.Date
  ghiChu          String?            @map("ghi_chu") @db.VarChar(500)
  huyAt           DateTime?          @map("huy_at")
  lyDoHuy         String?            @map("ly_do_huy") @db.VarChar(255)
  diaChiGiaoHang  String?            @map("dia_chi_giao_hang")
  trangThai       TrangThaiPhieuXuat @default(cho_xu_ly) @map("trang_thai")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  khachHangId String    @map("khach_hang_id")
  khachHang   KhachHang @relation(fields: [khachHangId], references: [id])

  // Dùng để tính doanh số / thống kê theo người tạo, không phải khóa nghiệp vụ bắt buộc
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("PhieuXuatHangCreatedBy", fields: [createdById], references: [id])

  phuongTienVanChuyenId String?              @map("phuong_tien_van_chuyen_id")
  phuongTienVanChuyen   PhuongTienVanChuyen? @relation(fields: [phuongTienVanChuyenId], references: [id])

  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("PhieuXuatHangUpdatedBy", fields: [updatedById], references: [id])

  xuatKhoById String? @map("xuat_kho_by_id")
  xuatKhoBoi  User?   @relation("PhieuXuatHangIssuedBy", fields: [xuatKhoById], references: [id])

  huyById String? @map("huy_by_id")
  huyBoi  User?   @relation("PhieuXuatHangCancelledBy", fields: [huyById], references: [id])

  chiTietPhieuXuatHangs ChiTietPhieuXuatHang[]
  phieuThuCongNos       PhieuThuCongNo[]

  // ---- Bổ sung theo màn hình "Chứng từ bán hàng" của MISA ----
  hinhThucThanhToan HinhThucThanhToan @default(chua_thu_tien) @map("hinh_thuc_thanh_toan")
  phuongThucThu     PhuongThucThanhToan? @map("phuong_thuc_thu") // dùng khi thu_tien_ngay
  tinhTrangNo       TinhTrangNo       @default(no_binh_thuong) @map("tinh_trang_no")
  soNgayDuocNo      Int?              @map("so_ngay_duoc_no")
  hanThanhToan      DateTime?         @map("han_thanh_toan") @db.Date
  thamChieu         String?           @map("tham_chieu") @db.VarChar(255)
  lapKemHoaDon      Boolean           @default(false) @map("lap_kem_hoa_don")
  daLapHoaDon       Boolean           @default(false) @map("da_lap_hoa_don")
  dieuKhoanKhac     String?           @map("dieu_khoan_khac") @db.VarChar(1000)
  tenMatHangChung   String?           @map("ten_mat_hang_chung") @db.VarChar(255)

  // Ảnh chụp thông tin khách tại thời điểm lập phiếu
  khachTenSnapshot      String? @map("khach_ten_snapshot") @db.VarChar(255)
  khachMaSoThueSnapshot String? @map("khach_ma_so_thue_snapshot") @db.VarChar(20)
  khachDiaChiSnapshot   String? @map("khach_dia_chi_snapshot") @db.VarChar(500)
  nguoiLienHe           String? @map("nguoi_lien_he") @db.VarChar(200)

  nhanVienBanHangId String?            @map("nhan_vien_ban_hang_id")
  nhanVienBanHang   NhanVienKinhDoanh? @relation("PhieuXuatNhanVien", fields: [nhanVienBanHangId], references: [id], onDelete: SetNull)

  dieuKhoanThanhToanId String?             @map("dieu_khoan_thanh_toan_id")
  dieuKhoanThanhToan   DieuKhoanThanhToan? @relation("PhieuXuatDieuKhoan", fields: [dieuKhoanThanhToanId], references: [id], onDelete: SetNull)

  baoGiaId String? @map("bao_gia_id")
  baoGia   BaoGia? @relation(fields: [baoGiaId], references: [id], onDelete: SetNull)

  traLaiHangBans TraLaiHangBan[]
  doiTrus        DoiTruChungTu[]

  @@index([trangThai, createdAt])
  @@map("phieu_xuat_hang")
}

model ChiTietPhieuXuatHang {
  id                     String   @id @default(uuid())
  maChiTietPhieuXuatHang String   @unique @map("ma_chi_tiet_phieu_xuat_hang")
  soLuong                Int      @map("so_luong") // theo donViTinh của dòng
  donViTinh              String   @map("don_vi_tinh") @db.VarChar(30)
  heSoQuyDoi             Int      @map("he_so_quy_doi") // snapshot lúc lập phiếu
  soLuongCoBan           Int      @map("so_luong_co_ban") // = soLuong × heSoQuyDoi
  donGia                 Decimal  @map("don_gia") @db.Decimal(15, 2) // theo donViTinh của dòng
  createdAt              DateTime @default(now()) @map("created_at")

  phieuXuatHangId String        @map("phieu_xuat_hang_id")
  phieuXuatHang   PhieuXuatHang @relation(fields: [phieuXuatHangId], references: [id])

  // Truy vết lô: 1 dòng xuất lấy hàng từ 1 lô cụ thể
  soLoId String @map("so_lo_id")
  soLo   SoLo   @relation(fields: [soLoId], references: [id])

  // Dòng tồn kho bị trừ khi xuất
  viTriId String @map("vi_tri_id")
  viTri   ViTri  @relation(fields: [viTriId], references: [id])

  // ---- Bổ sung theo lưới chi tiết của MISA (hàng tiền, thuế, giá vốn) ----
  laHangKhuyenMai Boolean @default(false) @map("la_hang_khuyen_mai")
  tyLeChietKhau   Decimal @default(0) @map("ty_le_chiet_khau") @db.Decimal(5, 2)
  tienChietKhau   Decimal @default(0) @map("tien_chiet_khau") @db.Decimal(15, 2)
  thueSuatGtgt    Decimal @default(0) @map("thue_suat_gtgt") @db.Decimal(5, 2)
  tienThueGtgt    Decimal @default(0) @map("tien_thue_gtgt") @db.Decimal(15, 2)
  donGiaVon       Decimal @default(0) @map("don_gia_von") @db.Decimal(15, 2) // theo donViTinh của dòng
  tienGiaVon      Decimal @default(0) @map("tien_gia_von") @db.Decimal(15, 2)

  chiTietTraLais ChiTietTraLai[]

  @@unique([phieuXuatHangId, soLoId, viTriId])
  @@map("chi_tiet_phieu_xuat_hang")
}

// ------------------------------------------------------------
// CÔNG NỢ: THU TỪ KHÁCH HÀNG / THANH TOÁN CHO NHÀ CUNG CẤP
// ------------------------------------------------------------

model PhieuThuCongNo {
  id               String              @id @default(uuid())
  maPhieuThuCongNo String              @unique @map("ma_phieu_thu_cong_no")
  soTien           Decimal             @map("so_tien") @db.Decimal(15, 2)
  ngayThanhToan    DateTime            @map("ngay_thanh_toan") @db.Date
  phuongThuc       PhuongThucThanhToan @map("phuong_thuc")
  ghiChu           String?             @map("ghi_chu") @db.VarChar(255)
  huyAt            DateTime?           @map("huy_at") // null = còn hiệu lực
  lyDoHuy          String?             @map("ly_do_huy") @db.VarChar(255)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  phieuXuatHangId String        @map("phieu_xuat_hang_id")
  phieuXuatHang   PhieuXuatHang @relation(fields: [phieuXuatHangId], references: [id])

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("PhieuThuCongNoCreatedBy", fields: [createdById], references: [id])

  huyById String? @map("huy_by_id")
  huyBoi  User?   @relation("PhieuThuCongNoVoidedBy", fields: [huyById], references: [id])

  // ---- Bổ sung theo màn hình "Thu tiền khách hàng" của MISA ----
  nguoiNop      String?   @map("nguoi_nop") @db.VarChar(200)
  ngayGhiSoQuy  DateTime? @map("ngay_ghi_so_quy") @db.Date
  tyLeChietKhau Decimal   @default(0) @map("ty_le_chiet_khau") @db.Decimal(5, 2)
  tienChietKhau Decimal   @default(0) @map("tien_chiet_khau") @db.Decimal(15, 2)

  nhanVienBanHangId String?            @map("nhan_vien_ban_hang_id")
  nhanVienBanHang   NhanVienKinhDoanh? @relation("PhieuThuNhanVien", fields: [nhanVienBanHangId], references: [id], onDelete: SetNull)

  doiTrus DoiTruChungTu[]

  @@index([ngayThanhToan])
  @@map("phieu_thu_cong_no")
}

model PhieuThanhToan {
  id               String              @id @default(uuid())
  maPhieuThanhToan String              @unique @map("ma_phieu_thanh_toan")
  soTien           Decimal             @map("so_tien") @db.Decimal(15, 2)
  ngayThanhToan    DateTime            @map("ngay_thanh_toan") @db.Date
  phuongThuc       PhuongThucThanhToan @map("phuong_thuc")
  ghiChu           String?             @map("ghi_chu") @db.VarChar(255)
  huyAt            DateTime?           @map("huy_at") // null = còn hiệu lực
  lyDoHuy          String?             @map("ly_do_huy") @db.VarChar(255)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  phieuNhapHangId String        @map("phieu_nhap_hang_id")
  phieuNhapHang   PhieuNhapHang @relation(fields: [phieuNhapHangId], references: [id])

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("PhieuThanhToanCreatedBy", fields: [createdById], references: [id])

  huyById String? @map("huy_by_id")
  huyBoi  User?   @relation("PhieuThanhToanVoidedBy", fields: [huyById], references: [id])

  @@index([ngayThanhToan])
  @@map("phieu_thanh_toan")
}

// ------------------------------------------------------------
// BỔ SUNG THEO MÀN HÌNH MISA SME (xem prisma/misa-test/schema.prisma)
// Chỉ thêm mới; không thay đổi ý nghĩa của các bảng đã có.
// ------------------------------------------------------------

// Nhóm khách hàng / nhà cung cấp
model NhomDoiTac {
  id  String @id @default(uuid())
  ma  String @unique @db.VarChar(20)
  ten String @db.VarChar(200)

  khachHangs  KhachHang[]  @relation("KhachHangNhom")
  nhaCungCaps NhaCungCap[] @relation("NhaCungCapNhom")

  @@map("nhom_doi_tac")
}

// Điều khoản thanh toán: số ngày được nợ mặc định
model DieuKhoanThanhToan {
  id           String @id @default(uuid())
  ma           String @unique @db.VarChar(20)
  ten          String @db.VarChar(200)
  soNgayDuocNo Int    @default(0) @map("so_ngay_duoc_no")

  khachHangs     KhachHang[]     @relation("KhachHangDieuKhoan")
  nhaCungCaps    NhaCungCap[]    @relation("NhaCungCapDieuKhoan")
  phieuXuatHangs PhieuXuatHang[] @relation("PhieuXuatDieuKhoan")

  @@map("dieu_khoan_thanh_toan")
}

// Nhân viên bán hàng / mua hàng. Có thể không có tài khoản đăng nhập (userId trống).
model NhanVienKinhDoanh {
  id        String   @id @default(uuid())
  maNV      String   @unique @map("ma_nv") @db.VarChar(20)
  hoTen     String   @map("ho_ten") @db.VarChar(200)
  dienThoai String?  @map("dien_thoai") @db.VarChar(20)
  trangThai Boolean  @default(true) @map("trang_thai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  khachHangs      KhachHang[]      @relation("KhachHangNhanVien")
  nhaCungCaps     NhaCungCap[]     @relation("NhaCungCapNhanVien")
  phieuXuatHangs  PhieuXuatHang[]  @relation("PhieuXuatNhanVien")
  phieuThuCongNos PhieuThuCongNo[] @relation("PhieuThuNhanVien")
  baoGias         BaoGia[]         @relation("BaoGiaNhanVien")

  @@map("nhan_vien_kinh_doanh")
}

// Tài khoản ngân hàng của khách hàng hoặc nhà cung cấp (đúng một trong hai chủ sở hữu)
model TaiKhoanNganHang {
  id             String  @id @default(uuid())
  soTaiKhoan     String  @map("so_tai_khoan") @db.VarChar(30)
  tenNganHang    String  @map("ten_ngan_hang") @db.VarChar(200)
  chiNhanh       String? @map("chi_nhanh") @db.VarChar(200)
  tinhTpNganHang String? @map("tinh_tp_ngan_hang") @db.VarChar(100)

  khachHangId  String?     @map("khach_hang_id")
  khachHang    KhachHang?  @relation("KhachHangNganHang", fields: [khachHangId], references: [id], onDelete: Cascade)
  nhaCungCapId String?     @map("nha_cung_cap_id")
  nhaCungCap   NhaCungCap? @relation("NhaCungCapNganHang", fields: [nhaCungCapId], references: [id], onDelete: Cascade)

  // NULL không bằng nhau trong unique, nên mỗi ràng buộc chỉ áp cho đúng một loại chủ
  @@unique([khachHangId, soTaiKhoan, tenNganHang])
  @@unique([nhaCungCapId, soTaiKhoan, tenNganHang])
  @@map("tai_khoan_ngan_hang")
}

// Nhiều địa điểm giao hàng cho một khách
model DiaDiemGiaoHang {
  id        String  @id @default(uuid())
  diaDiem   String  @map("dia_diem") @db.VarChar(500)
  laMacDinh Boolean @default(false) @map("la_mac_dinh")

  khachHangId String    @map("khach_hang_id")
  khachHang   KhachHang @relation(fields: [khachHangId], references: [id], onDelete: Cascade)

  @@map("dia_diem_giao_hang")
}

// Báo giá cho khách: đơn giá, thuế suất, chiết khấu từng mặt hàng
model BaoGia {
  id         String    @id @default(uuid())
  maBaoGia   String    @unique @map("ma_bao_gia") @db.VarChar(30)
  ngayBaoGia DateTime  @map("ngay_bao_gia") @db.Date
  hanHieuLuc DateTime? @map("han_hieu_luc") @db.Date
  ghiChu     String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  khachHangId String    @map("khach_hang_id")
  khachHang   KhachHang @relation(fields: [khachHangId], references: [id])

  nhanVienBanHangId String?            @map("nhan_vien_ban_hang_id")
  nhanVienBanHang   NhanVienKinhDoanh? @relation("BaoGiaNhanVien", fields: [nhanVienBanHangId], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("BaoGiaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  chiTiets       ChiTietBaoGia[]
  phieuXuatHangs PhieuXuatHang[]

  @@index([khachHangId])
  @@map("bao_gia")
}

model ChiTietBaoGia {
  id            String  @id @default(uuid())
  donViTinh     String  @map("don_vi_tinh") @db.VarChar(30)
  soLuong       Int     @map("so_luong")
  donGia        Decimal @map("don_gia") @db.Decimal(15, 2)
  tyLeChietKhau Decimal @default(0) @map("ty_le_chiet_khau") @db.Decimal(5, 2)
  thueSuatGtgt  Decimal @default(0) @map("thue_suat_gtgt") @db.Decimal(5, 2)
  thuTu         Int     @default(0) @map("thu_tu") // thứ tự dòng khi nhập

  baoGiaId  String  @map("bao_gia_id")
  baoGia    BaoGia  @relation(fields: [baoGiaId], references: [id], onDelete: Cascade)
  hangHoaId String  @map("hang_hoa_id")
  hangHoa   HangHoa @relation(fields: [hangHoaId], references: [id])

  @@index([baoGiaId])
  @@map("chi_tiet_bao_gia")
}

// Trả lại hàng bán: hàng khách trả được nhập lại kho (qua TonKhoService), giảm trừ công nợ
model TraLaiHangBan {
  id         String             @id @default(uuid())
  maTraLai   String             @unique @map("ma_tra_lai") @db.VarChar(30)
  ngayTraLai DateTime           @map("ngay_tra_lai") @db.Date
  trangThai  TrangThaiPhieuNhap @default(cho_xac_nhan) @map("trang_thai")
  lyDo       String?            @map("ly_do") @db.VarChar(255)
  ghiChu     String?            @db.VarChar(500)
  xacNhanAt  DateTime?          @map("xac_nhan_at")
  huyAt      DateTime?          @map("huy_at")
  lyDoHuy    String?            @map("ly_do_huy") @db.VarChar(255)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  khachHangId String    @map("khach_hang_id")
  khachHang   KhachHang @relation(fields: [khachHangId], references: [id])

  // Phiếu xuất gốc (có thể trống nếu trả hàng ngoài chứng từ)
  phieuXuatHangId String?        @map("phieu_xuat_hang_id")
  phieuXuatHang   PhieuXuatHang? @relation(fields: [phieuXuatHangId], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("TraLaiHangBanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  chiTiets ChiTietTraLai[]

  @@index([khachHangId])
  @@index([trangThai, createdAt])
  @@map("tra_lai_hang_ban")
}

model ChiTietTraLai {
  id            String  @id @default(uuid())
  maChiTiet     String  @unique @map("ma_chi_tiet") @db.VarChar(40)
  soLuong       Int     @map("so_luong") // theo donViTinh của dòng
  donViTinh     String  @map("don_vi_tinh") @db.VarChar(30)
  heSoQuyDoi    Int     @map("he_so_quy_doi")
  soLuongCoBan  Int     @map("so_luong_co_ban")
  donGia        Decimal @map("don_gia") @db.Decimal(15, 2)
  tyLeChietKhau Decimal @default(0) @map("ty_le_chiet_khau") @db.Decimal(5, 2)
  tienChietKhau Decimal @default(0) @map("tien_chiet_khau") @db.Decimal(15, 2)

  traLaiId String        @map("tra_lai_id")
  traLai   TraLaiHangBan @relation(fields: [traLaiId], references: [id], onDelete: Cascade)

  soLoId  String @map("so_lo_id")
  soLo    SoLo   @relation(fields: [soLoId], references: [id])
  viTriId String @map("vi_tri_id")
  viTri   ViTri  @relation(fields: [viTriId], references: [id])

  // Dòng của phiếu xuất gốc mà dòng trả này đối ứng (nếu có)
  chiTietPhieuXuatHangId String?               @map("chi_tiet_phieu_xuat_hang_id")
  chiTietPhieuXuatHang   ChiTietPhieuXuatHang? @relation(fields: [chiTietPhieuXuatHangId], references: [id], onDelete: SetNull)

  @@index([traLaiId])
  @@map("chi_tiet_tra_lai")
}

// Đối trừ chứng từ: ghép phiếu thu với phiếu xuất (nhiều-nhiều, có số tiền)
// cho phép một phiếu thu thanh toán nhiều phiếu xuất ("thu tiền hàng loạt")
model DoiTruChungTu {
  id           String   @id @default(uuid())
  ngayDoiTru   DateTime @map("ngay_doi_tru") @db.Date
  soTienDoiTru Decimal  @map("so_tien_doi_tru") @db.Decimal(15, 2)
  daBoDoiTru   Boolean  @default(false) @map("da_bo_doi_tru")
  createdAt    DateTime @default(now()) @map("created_at")

  phieuThuCongNoId String         @map("phieu_thu_cong_no_id")
  phieuThuCongNo   PhieuThuCongNo @relation(fields: [phieuThuCongNoId], references: [id])
  phieuXuatHangId  String         @map("phieu_xuat_hang_id")
  phieuXuatHang    PhieuXuatHang  @relation(fields: [phieuXuatHangId], references: [id])

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("DoiTruChungTuCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([phieuThuCongNoId])
  @@index([phieuXuatHangId])
  @@map("doi_tru_chung_tu")
}

// ------------------------------------------------------------
// HẠ TẦNG DÙNG CHUNG
// ------------------------------------------------------------

// Tệp đính kèm đa hình: nội dung nằm trên đĩa máy chủ (UPLOAD_DIR), MySQL chỉ giữ
// đường dẫn tương đối và metadata. Không có FK tới đối tượng đích (service kiểm tồn tại).
model TepDinhKem {
  id           String          @id @default(uuid())
  loaiDoiTuong LoaiDoiTuongTep @map("loai_doi_tuong")
  doiTuongId   String          @map("doi_tuong_id") @db.VarChar(36)
  tenFile      String          @map("ten_file") @db.VarChar(150)
  mime         String          @db.VarChar(100)
  kichThuoc    Int             @map("kich_thuoc")
  duongDan     String          @unique @map("duong_dan") @db.VarChar(255)
  createdAt    DateTime        @default(now()) @map("created_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id])

  @@index([loaiDoiTuong, doiTuongId])
  @@map("tep_dinh_kem")
}

// Nhật ký thao tác nhạy cảm (append-only). Xem docs/03-cross-cutting/audit-trail.md
model NhatKyHeThong {
  id         String   @id @default(uuid())
  hanhDong   String   @map("hanh_dong") @db.VarChar(100)
  doiTuong   String   @map("doi_tuong") @db.VarChar(50)
  doiTuongId String?  @map("doi_tuong_id") @db.VarChar(36)
  truoc      Json?
  sau        Json?
  lyDo       String?  @map("ly_do") @db.VarChar(255)
  ip         String?  @db.VarChar(45)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([doiTuong, doiTuongId])
  @@index([hanhDong, createdAt])
  @@index([userId, createdAt])
  @@map("nhat_ky_he_thong")
}

// Bộ đếm sinh mã chứng từ. ngay = 'yyMMdd' với mã theo ngày, '' với mã liên tục.
model BoDemMa {
  tienTo String @map("tien_to") @db.VarChar(10)
  ngay   String @default("") @db.VarChar(6)
  giaTri Int    @default(0) @map("gia_tri")

  @@id([tienTo, ngay])
  @@map("bo_dem_ma")
}

// Sổ cái biến động tồn kho (append-only). Với mỗi (soLoId, viTriId):
// TonKho.soLuong = tổng soLuongThayDoi. Xem docs/03-cross-cutting/audit-trail.md
model BienDongTonKho {
  id             String       @id @default(uuid())
  loai           LoaiBienDong
  soLuongThayDoi Int          @map("so_luong_thay_doi") // có dấu, đơn vị cơ bản
  soLuongSau     Int          @map("so_luong_sau")
  loaiThamChieu  String?      @map("loai_tham_chieu") @db.VarChar(50)
  thamChieuId    String?      @map("tham_chieu_id") @db.VarChar(36)
  lyDo           String?      @map("ly_do") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at")

  soLoId String @map("so_lo_id")
  soLo   SoLo   @relation(fields: [soLoId], references: [id])

  viTriId String @map("vi_tri_id")
  viTri   ViTri  @relation(fields: [viTriId], references: [id])

  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([soLoId, createdAt])
  @@index([viTriId, createdAt])
  @@index([loaiThamChieu, thamChieuId])
  @@map("bien_dong_ton_kho")
}
